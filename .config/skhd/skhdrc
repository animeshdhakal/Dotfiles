alt + shift - r : yabai --restart-service; skhd --restart-service; killall neru 2>/dev/null; open -a Neru

rcmd - h: skhd -k "left"
rcmd - l: skhd -k "right"
rcmd - k: skhd -k "up"
rcmd - j: skhd -k "down"

alt - return         : open -na "Kitty"
shift + alt - return : open -na "Firefox"
shift + alt - f      : /Users/animesh/.bin/kitty-toggle.sh
shift + alt - t      : open -a "TickTick"
shift + alt - i      : open -a "IINA"
shift + alt - 0x29   : pmset displaysleepnow # Semicolon
shift + alt - l      : open -a "LocalSend"

alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east

ctrl + alt - h : yabai -m window --resize left:-50:0 2>/dev/null || yabai -m window --resize right:-50:0 2>/dev/null
ctrl + alt - j : yabai -m window --resize bottom:0:50 2>/dev/null || yabai -m window --resize top:0:50 2>/dev/null
ctrl + alt - k : yabai -m window --resize top:0:-50 2>/dev/null || yabai -m window --resize bottom:0:-50 2>/dev/null
ctrl + alt - l : yabai -m window --resize right:50:0 2>/dev/null || yabai -m window --resize left:50:0 2>/dev/null

alt - w : yabai -m window --close
alt - f : yabai -m window --toggle zoom-fullscreen
alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2
alt - v : yabai -m window --toggle split
alt - p : yabai -m window --toggle zoom-parent
alt - e : yabai -m space --balance
alt - r : yabai -m space --rotate 90

# Workspaces: 1-5 on Screen 1, 6-0 (10) on Screen 2
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - 0 : yabai -m space --focus 10

# Send window to workspace: 1-5 on Screen 1, 6-0 (10) on Screen 2
shift + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
shift + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4
shift + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5
shift + alt - 6 : yabai -m window --space 6; yabai -m space --focus 6
shift + alt - 7 : yabai -m window --space 7; yabai -m space --focus 7
shift + alt - 8 : yabai -m window --space 8; yabai -m space --focus 8
shift + alt - 9 : yabai -m window --space 9; yabai -m space --focus 9
shift + alt - 0 : yabai -m window --space 10; yabai -m space --focus 10

alt - 0x1E : yabai -m space --focus next || yabai -m space --focus first # ] key
alt - 0x21 : yabai -m space --focus prev || yabai -m space --focus last  # [ key

ctrl + alt - 1 : yabai -m display --focus 1
ctrl + alt - 2 : yabai -m display --focus 2

shift + alt - n : yabai -m window --display next; yabai -m display --focus next
shift + alt - p : yabai -m window --display prev; yabai -m display --focus prev
